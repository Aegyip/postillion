@component('components/app_shell', { title: (chat ? chat.title : 'Chat') + ' — Postillion', devices, chats, livenessKnown, activeChatId: chat ? chat.id : null })
  <header class="topbar">
    <h1>{{ chat ? chat.title : 'Chat' }}</h1>
    @if (chat && chat.location)
      <span class="meta">{{ chat.location }}</span>
    @end
  </header>

  <div class="scroll" data-chat-id="{{ chat ? chat.id : '' }}" data-head-seq="{{ headSeq }}">
    @if (unreachable)
      {{-- Ulaşılamamak ile boş olmak AYRI: ilki arıza. --}}
      <div class="page">
        <ul class="errors">
          <li>The server could not be reached, so the transcript is unavailable.</li>
        </ul>
      </div>
    @elseif (!messages.length)
      <div class="page">
        <p class="empty">No messages in this chat yet.</p>
      </div>
    @else
      <ol class="transcript">
        @each (message in messages)
          <li class="msg {{ message.role }}">
            <span class="who">{{ message.role === 'user' ? 'You' : 'Agent' }}</span>
            @each (part in message.parts)
              @if (part.kind === 'text')
                <p class="text">{{ part.text }}</p>
              @elseif (part.kind === 'error')
                <p class="part-error">{{ part.message }}</p>
              @elseif (part.kind === 'tool')
                <p class="tool">
                  {{ part.call && part.call.command ? part.call.command : (part.call && part.call.path ? part.call.path : 'tool') }}
                  @if (!part.resolved)
                    <span class="pending">running</span>
                  @end
                </p>
              @end
            @end
          </li>
        @end
      </ol>
    @end
  </div>

  <div class="composer">
    @if (flashMessages.has('errorsBag'))
      <ul class="errors">
        @each (message in (flashMessages.get('errorsBag') ?? {}))
          <li>{{ message }}</li>
        @end
      </ul>
    @end

    @if (chat && chat.deviceOnline)
      <form method="POST" action="/app/chats/{{ chat.id }}/send">
        {{ csrfField() }}
        <input type="text" name="prompt" placeholder="Do anything…" required
               maxlength="20000" autocomplete="off"
               value="{{ flashMessages.get('prompt') ?? '' }}" />
        <button class="btn send" type="submit" aria-label="Send">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 19V5M5 12l7-7 7 7" />
          </svg>
        </button>
      </form>
    @elseif (chat && livenessKnown)
      {{-- Yazma kapalıysa SEBEBİ yazılı olmalı: kaybolmuş bir kutu soru
           bırakır. Okumak zaten çalışıyor. --}}
      <p class="hint">
        This chat's device is off. You can read the history; writing needs the
        device to be running.
      </p>
    @end
  </div>

  <div class="statusbar">
    <span>{{ chat && chat.cwd ? chat.cwd : 'no checkout' }}</span>
    @if (chat && chat.branch)
      <span class="right">{{ chat.branch }}</span>
    @end
  </div>
@end
