@component('components/app_shell', { title: (chat ? chat.title : 'Chat') + ' — Postillion', devices, chats, livenessKnown, activeChatId: chat ? chat.id : null })
  <header class="topbar">
    <h1>{{ chat ? chat.title : 'Chat' }}</h1>
    @if (chat && chat.location)
      <span class="meta">{{ chat.location }}</span>
    @end
  </header>

  <div class="scroll" data-chat-id="{{ chat ? chat.id : '' }}" data-head-seq="{{ headSeq }}">
    @if (unreachable)
      {{-- Ulaşılamamak ile boş olmak AYRI: ilki arıza. --}}
      <div class="page">
        <ul class="errors">
          <li>The server could not be reached, so the transcript is unavailable.</li>
        </ul>
      </div>
    @elseif (!messages.length)
      <div class="page">
        <p class="empty">No messages in this chat yet.</p>
      </div>
    @else
      @include('partials/transcript')
    @end
  </div>

  <div class="composer">
    @if (flashMessages.has('errorsBag'))
      <ul class="errors">
        @each (message in (flashMessages.get('errorsBag') ?? {}))
          <li>{{ message }}</li>
        @end
      </ul>
    @end

    @if (chat && chat.deviceOnline)
      <form method="POST" action="/app/chats/{{ chat.id }}/send">
        {{ csrfField() }}
        <input type="text" name="prompt" placeholder="Do anything…" required
               maxlength="20000" autocomplete="off"
               value="{{ flashMessages.get('prompt') ?? '' }}" />
        <button class="btn send" type="submit" aria-label="Send">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 19V5M5 12l7-7 7 7" />
          </svg>
        </button>
      </form>
    @elseif (chat && livenessKnown)
      {{-- Yazma kapalıysa SEBEBİ yazılı olmalı: kaybolmuş bir kutu soru
           bırakır. Okumak zaten çalışıyor. --}}
      <p class="hint">
        This chat's device is off. You can read the history; writing needs the
        device to be running.
      </p>
    @end
  </div>

  {{-- Uygulamanın composer footer'ı: ajan · model · seviye, sağda bağlam
       ölçeri. Buradakiler OKUNUYOR, seçilmiyor — seçim cihazdaki motora bir
       RPC gerektiriyor ve o yol henüz açık değil. --}}
  <div class="statusbar">
    @if (chat && chat.harness)
      <span class="chip">{{ chat.harness }}</span>
    @end

    {{-- Model listesi cihazdan geliyor; kapalıyken seçim de yazma da
         yapılamıyor, o yüzden seçici yerine sabit etiket duruyor. --}}
    @if (models.length)
      <form class="pick" method="POST" action="/app/chats/{{ chat.id }}/config">
        {{ csrfField() }}
        <select name="model" onchange="this.form.requestSubmit()">
          @each (model in models)
            <option value="{{ model.id }}" {{ model.id === chat.model ? 'selected' : '' }}>
              {{ model.label }}
            </option>
          @end
        </select>
      </form>
    @elseif (chat && chat.model)
      <span class="chip">{{ chat.model }}</span>
    @end

    @if (chat && chat.reasoning)
      <span class="chip">{{ chat.reasoning }}</span>
    @end
    @if (chat && chat.running)
      <span class="chip working">working</span>
    @end

    <span class="right">
      @if (contextPercent !== null)
        {{-- Çıplak bir "232k" pencerenin neresinde olunduğunu söylemiyor;
             asıl sorulan bu. --}}
        <span class="meter {{ contextLevel }}" title="{{ contextTokens }} tokens">
          <span class="meter-bar"><span style="width: {{ contextPercent }}%"></span></span>
          {{ contextLabel }} · %{{ contextPercent }}
        </span>
      @end
      @if (chat && chat.branch)
        <span class="branch">{{ chat.branch }}</span>
      @end
    </span>
  </div>
@end
